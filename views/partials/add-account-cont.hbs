<div class="content">
    <form id="addAccountForm" action="/add-account" method="POST">

        <div class = "acctInfo">
            <h1>{{ header }}</h1>

            <div class="input-group">
                <div class="name-container">
                    <input type="text" name="firstName" id="firstName" placeholder="First Name" required />
                    <input type="text" name="lastName" id="lastName" placeholder="Last Name" required />
                </div>
                <input type="email" name="emailAddress" id="emailAddress" placeholder="Email" required />
                <input type="password" name="password" id="password" placeholder="Password" required />

                <div class="password-container">
                    <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm Password" required />
                    <span class="show-password">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>

                <div class="recovery-question">
                    <select name="recoveryQuestion" id="recoveryQuestion" required>
                        <option value="">Select Password Recovery Question</option>
                        <option value="1">What was the name of your first kiss?</option>
                        <option value="2">What was the name of your first childhood friend?</option>
                        <option value="3">What was your childhood neighbor's last name?</option>
                    </select>
                </div>

                <div class="recovery-answer">
                    <input type="password" name="recoveryAnswer" id="recoveryAnswer" placeholder="Recovery Question Answer" required=""/>
                    <span class="show-password">
                        <i class="fas fa-eye recovery"></i>
                    </span>
                </div>
            </div>

            <div class="save-edits">
                <div class="button">
                    <input type="submit" name="saveEdits" id="saveEdits" value="Sign Up">
                </div>
            </div>
        </div>
    </form>
</div>