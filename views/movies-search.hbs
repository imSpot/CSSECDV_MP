<head>
    <title>Eduksine | Search</title>
    <link rel="stylesheet" type="text/css" href="./css/movies-search.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css">
    {{> header }}
</head>

<body>
    {{> nav-bar }}
    
    {{#if errorMessage}}
        <div class="error-message-container">
            <p>
                No results found for <span class="highlight">"{{title}}"</span>. Please try another search.
            </p>
        </div>
    {{else}}
        {{> movie-search-cont }}
    {{/if}}

    <script src="./js/movies_search.js"></script> 
</body>