<div id="admin-container">
    <div id="left-panel" class="panels">
        <div id="admin-radio-buttons">
            <input type="radio" id="radio-button-view" name="radio-button" value="view">
            <label for="radio-button-view">View</label><br>
            <input type="radio" id="radio-button-add" name="radio-button" value="add">
            <label for="radio-button-add">Add</label><br>
            <input type="radio" id="radio-button-edit" name="radio-button" value="edit">
            <label for="radio-button-edit">Edit</label><br>
            <input type="radio" id="radio-button-delete" name="radio-button" value="delete">
            <label for="radio-button-delete">Delete</label><br>
        </div>
    </div>

    <div id="right-panel" class="panels">
        <div id="admin-options">
            <!--Append table selection and search. Search doesn't appear when radio-button-edit is selected.-->
        </div>
        <div id="content">
            <!--Append the stuff here.-->
            Click a button to start
        </div>
    </div>
</div>